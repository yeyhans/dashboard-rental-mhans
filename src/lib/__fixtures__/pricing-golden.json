{
  "name": "mhans-order-pricing-golden",
  "version": 1,
  "description": "Language-neutral golden cases for the Mario Hans order money formula. Every implementation (dashboard TypeScript, customer frontend, Hermes Python) must reproduce the expected block exactly from the input block. All amounts are CLP integers.",
  "rules": [
    "1. line_subtotal = round(unit_daily_price * quantity * jornadas). price and quantity may arrive as strings: coerce to number; NaN or negative is an error.",
    "2. jornadas = inclusive calendar days between date-only strings 'YYYY-MM-DD': (UTC(end) - UTC(start)) / 86400000 + 1, built from the Y-M-D parts (never local time, so DST cannot change it). end < start is an error. When no dates are given, an explicit positive integer 'jornadas' is used.",
    "3. products_subtotal = sum of line_subtotal.",
    "4. discount: coupon.discount_type 'percent' -> round(products_subtotal * amount / 100), capped by coupon.maximum_amount when it is set and > 0; 'fixed_cart' -> amount; 'fixed_product' -> amount (flat, pending business decision); unknown type -> 0. Without a coupon, the manual 'discount' is used (0 when absent). The result is clamped to [0, products_subtotal]. The discount never touches shipping.",
    "5. net (stored as calculated_subtotal) = products_subtotal - discount + shipping_total. Shipping is taxed.",
    "6. iva = apply_iva ? round(net * 0.19) : 0. total = net + iva.",
    "7. reserve: reserve_type 'fixed' -> reserve_value; anything else -> total * reserve_value / 100 (reserve_value defaults to 25 when null). Rounded, then clamped to [0, total]. balance = total - reserve.",
    "8. reserve_label: 'Reserva N%' for a percentage (N without trailing decimals), 'Reserva' for a fixed amount."
  ],
  "rounding": "round() is half-up (x.5 goes to x+1) for non-negative values. Python's built-in round() is banker's rounding and MUST NOT be used; use math.floor(x + 0.5) or Decimal ROUND_HALF_UP. IVA is computed in integer arithmetic: floor((net * 19 + 50) / 100).",
  "cases": [
    {
      "name": "no_shipping",
      "note": "Two lines over 3 days, no coupon, default 25% reserve. 22312.5 rounds up.",
      "input": {
        "line_items": [{ "price": 10000, "quantity": 2 }, { "price": 5000, "quantity": 1 }],
        "start_date": "2027-03-01",
        "end_date": "2027-03-03",
        "shipping_total": 0,
        "coupon": null,
        "discount": null,
        "apply_iva": true,
        "reserve_type": "percent",
        "reserve_value": 25
      },
      "expected": {
        "jornadas": 3,
        "line_subtotals": [60000, 15000],
        "products_subtotal": 75000,
        "discount": 0,
        "shipping_total": 0,
        "net": 75000,
        "iva": 14250,
        "total": 89250,
        "reserve": 22313,
        "balance": 66937,
        "reserve_label": "Reserva 25%"
      }
    },
    {
      "name": "shipping_15000",
      "note": "Shipping is added to the taxable base.",
      "input": {
        "line_items": [{ "price": 10000, "quantity": 2 }, { "price": 5000, "quantity": 1 }],
        "start_date": "2027-03-01",
        "end_date": "2027-03-03",
        "shipping_total": 15000,
        "coupon": null,
        "discount": null,
        "apply_iva": true,
        "reserve_type": "percent",
        "reserve_value": 25
      },
      "expected": {
        "jornadas": 3,
        "line_subtotals": [60000, 15000],
        "products_subtotal": 75000,
        "discount": 0,
        "shipping_total": 15000,
        "net": 90000,
        "iva": 17100,
        "total": 107100,
        "reserve": 26775,
        "balance": 80325,
        "reserve_label": "Reserva 25%"
      }
    },
    {
      "name": "percent_coupon_without_maximum",
      "note": "10% of the products subtotal.",
      "input": {
        "line_items": [{ "price": 10000, "quantity": 2 }, { "price": 5000, "quantity": 1 }],
