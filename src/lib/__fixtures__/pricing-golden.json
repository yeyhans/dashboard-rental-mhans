        "line_subtotals": [60000, 15000],
        "products_subtotal": 75000,
        "discount": 7500,
        "shipping_total": 0,
        "net": 67500,
        "iva": 12825,
        "total": 80325,
        "reserve": 20081,
        "balance": 60244,
        "reserve_label": "Reserva 25%"
