---
import Base from "../layout/Base.astro";
import { getServerAdmin, clearAuthCookies } from "../lib/supabase";
import { DashboardService } from "../services/dashboardService";
import { ORDER_STATUSES, emptyStatusBuckets } from "../lib/orderStatus";
import DashboardContainer from "../components/DashboardContainer";
import OperationalAgenda from "../components/OperationalAgenda.astro";
import { AgendaService } from "../services/agendaService";

export const prerender = false;

// Verificación de autenticación y admin usando el nuevo sistema
const adminSession = await getServerAdmin(Astro);

if (!adminSession) {
  console.log("🚫 Acceso denegado al dashboard - Usuario no es administrador");
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

console.log("✅ Admin autenticado en dashboard:", adminSession.admin.email);

/**
 * La agenda se carga aparte y con su propio `catch`. Si falla, el resto del Centro de Control
 * sigue en pie con la agenda vacia: un error en un panel no debe dejar la pantalla en blanco.
 */
let agenda: Awaited<ReturnType<typeof AgendaService.getAgenda>> = [];
try {
  agenda = await AgendaService.getAgenda();
} catch (error) {
  console.error("[dashboard] Error al cargar la agenda operacional:", {
    admin: adminSession.admin.email,
    error,
  });
}

// Cargar datos del dashboard con manejo de errores mejorado
let dashboardStats;
try {
  console.log("📊 Cargando estadísticas del dashboard...");
  dashboardStats = await DashboardService.getDashboardStats();

  console.log("✅ Dashboard Stats cargadas:", {
    adminUser: adminSession.admin.email,
    monthlyOrders: dashboardStats.monthlyOrderStats.totalOrders,
    rentedEquipment: dashboardStats.rentedEquipment.length,
    totalSales: dashboardStats.financialSummary.totalSales,
    sessionType: adminSession.isExtended ? "Extendida (30 días)" : "Regular",
  });
} catch (error) {
  console.error("❌ Error cargando dashboard stats:", error);
  // Estructura de datos vacía para evitar errores de renderizado
  dashboardStats = {
    monthlyOrderStats: {
      totalOrders: 0,
      createdOrders: 0,
      byStatus: Object.fromEntries(ORDER_STATUSES.map((s) => [s, 0])),
    },
    operationalKpis: {
      retirosHoy: 0,
      entregasHoy: 0,
      devolucionesHoy: 0,
      pedidosActivos: 0,
    },
    ordersByStatus: emptyStatusBuckets(),
    rentedEquipment: [],
    financialSummary: {
      totalSales: 0,
      totalPaid: 0,
      totalPending: 0,
      reservationPayments: 0,
      finalPayments: 0,
    },
  };
}

// Datos adicionales para el dashboard (se pasarán al componente)
const dashboardContext = {
  adminUser: {
    email: adminSession.admin.email,
    role: adminSession.admin.role,
    id: adminSession.admin.id,
  },
  session: {
    isExtended: adminSession.isExtended,
    expiresAt: (() => {
      const d = new Date(adminSession.expiresAt);
      return `${String(d.getDate()).padStart(2, "0")}-${String(d.getMonth() + 1).padStart(2, "0")}-${d.getFullYear()}`;
    })(),
    userId: adminSession.user.id,
  },
};

const title = `Dashboard - Rental Mario Hans | ${adminSession.admin.email}`;
---

<Base title={title}>
  <div class="container py-3 px-2 sm:px-4">
    <!--
      D-21 (01e): grid canónico main + side, igual que `.main-row` de
      `Centro_Control_Canonical_RC2.1.2`. La agenda ya no va a todo el ancho arriba del header
      (D-04 la dejó ahí por simplicidad): ahora es la columna lateral "Próximas Operaciones" junto
      al contenido principal en desktop, y se apila debajo en mobile (`lg:` es el corte).
    -->
    <div
      class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start"
    >
      <div class="min-w-0">
        <!--
          D-04: el header (PageHeader + 5 KPI + acciones "Nuevo Pedido"/"Registrar Devolución")
          vive dentro de DashboardContainer, no aquí — así son un único árbol React y `actions`
          recibe JSX real en vez de intentar pasar slots de Astro a props de un componente framework.
        -->
        <DashboardContainer
          client:load
          initialData={dashboardStats}
          adminContext={dashboardContext}
        />
      </div>
      <div class="min-w-0">
        <OperationalAgenda agenda={agenda} />
      </div>
    </div>
  </div>
</Base>
