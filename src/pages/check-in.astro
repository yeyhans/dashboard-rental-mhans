---
import Base from "../layout/Base.astro";
import CheckInBoard from "../components/checkin/CheckInBoard";
import { getServerAdmin, clearAuthCookies } from "../lib/supabase";
import { CheckInService } from "../services/checkInService";
import { businessDay } from "../lib/businessDay";

export const prerender = false;

const adminSession = await getServerAdmin(Astro);

if (!adminSession) {
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

// El reloj se resuelve en el servidor: el tablero decide atrasos y "hoy", y hacerlo en el
// navegador dejaría el resultado a merced de la zona horaria del equipo del admin.
const now = new Date();

let board = {
  kpis: { pendientesHoy: 0, recibidosHoy: 0, incidencias: 0, atrasadas: 0 },
  entries: [],
};
let loadError: string | null = null;

try {
  board = await CheckInService.getBoard(now);
} catch (error) {
  console.error("[check-in] Error al cargar el tablero de devoluciones:", {
    admin: adminSession.admin.email,
    error,
  });
  loadError =
    "No se pudieron cargar las devoluciones. Recarga la página o inténtalo en unos minutos.";
}

const todayLabel = new Intl.DateTimeFormat("es-CL", {
  weekday: "long",
  day: "numeric",
  month: "long",
}).format(now);
// D-15: cada fila necesita "hoy" para decidir si "Vence 13:00" muestra su fecha o no; se resuelve
// aquí, no en el navegador, por la misma razón que `todayLabel`.
const todayIsoDay = businessDay(now);

const title = `Check-In / Devoluciones | ${adminSession.admin.email}`;
---

<Base title={title}>
  <div class="container py-6">
    {
      loadError ? (
        <>
          {/*
          D-06: el header canónico (PageHeader) vive dentro de CheckInBoard, igual que D-04 en
          DashboardContainer — pero si el board no cargó no hay componente que lo pinte, así que
          este fallback mínimo se conserva solo para la ruta de error.
        */}
          <header class="mb-5 border-b border-[var(--color-border)] pb-4">
            <h1 class="text-xl font-semibold tracking-tight">
              Check-In / Devoluciones
            </h1>
          </header>
          <div
            role="alert"
            class="rounded-[10px] border border-[var(--color-crit)] bg-[var(--color-crit-bg)] p-4 text-sm text-[var(--color-crit)]"
          >
            {loadError}
          </div>
        </>
      ) : (
        <CheckInBoard
          client:load
          data={board}
          todayLabel={todayLabel}
          todayIsoDay={todayIsoDay}
        />
      )
    }
  </div>
</Base>
