---
import Base from "../layout/Base.astro";
import SiteSettingsForm from "../components/settings/SiteSettingsForm";
import { clearAuthCookies, getServerAdmin } from "../lib/supabase";
import { ADMIN_HOME } from "../lib/accessControl";
import { SiteSettingsService } from "../services/siteSettingsService";
import { DEFAULT_SETTINGS, type SiteSettings } from "../lib/siteSettings";

export const prerender = false;

// Business settings (migration 0015). super_admin only — the API behind the form says the same
// with `requireRole('super_admin')`; this check keeps a plain admin from seeing a page whose
// every action would answer 403.
const adminSession = await getServerAdmin(Astro);

if (!adminSession) {
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

if (adminSession.admin.role !== "super_admin") {
  return Astro.redirect(ADMIN_HOME);
}

let settings: SiteSettings = DEFAULT_SETTINGS;
let loadError: string | null = null;

try {
  settings = await SiteSettingsService.get();
} catch (error) {
  console.error("[settings] Error al cargar la configuración del sitio:", {
    admin: adminSession.admin.email,
    error,
  });
  loadError =
    "No se pudo cargar la configuración. Recarga la página o inténtalo en unos minutos.";
}

const title = `Configuración del sitio | ${adminSession.admin.email}`;
---

<Base title={title}>
  <div class="container py-6">
    {
      loadError ? (
        <div
          role="alert"
          class="rounded-[10px] border border-[var(--color-crit)] bg-[var(--color-crit-bg)] p-4 text-sm text-[var(--color-crit)]"
        >
          {loadError}
        </div>
      ) : (
        <SiteSettingsForm client:load initialSettings={settings} />
      )
    }
  </div>
</Base>
