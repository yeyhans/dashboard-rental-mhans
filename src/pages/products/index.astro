---
import Base from "../../layout/Base.astro";
import ProductsDashboard from "../../components/ProductsDashboard";
import { getServerAdmin, clearAuthCookies } from "../../lib/supabase";
import { ProductService } from "../../services/productService";
import { CategoryService } from "../../services/categoryService";
import { CatalogService } from "../../services/catalogService";
import CatalogKpiRow from "../../components/CatalogKpiRow.astro";
import { InventoryKpiRow } from "../../components/inventory/canon/InventoryKpiRow";
import {
  summarizeInventoryKpis,
  type InventoryKpis,
} from "../../components/inventory/canon/inventoryKpis";
import { chunkProductIds } from "../../components/products/productUnitCounts";
import { ProductUnitCountsService } from "../../services/productUnitCountsService";

export const prerender = false;

// Verificar autenticación usando el nuevo sistema
const adminSession = await getServerAdmin(Astro);

if (!adminSession) {
  console.log("🚫 Acceso denegado a products - Usuario no es administrador");
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

console.log("✅ Admin autenticado en products:", adminSession.admin.email);

// Extract access token from cookies
const accessToken = Astro.cookies.get("sb-access-token")?.value || "";

if (!accessToken) {
  console.error("❌ No access token found in cookies");
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

// Load ALL products and categories for client-side pagination and filtering
// This ensures we have all data available for proper pagination
const { products, total } = await ProductService.searchProducts("", 1, 1000); // Load up to 1000 products
const { categories } = await CategoryService.getAllCategories(1, 100); // Load all categories

const productsData = {
  products: products || [],
  total: total || 0,
};

const categoriesData = {
  categories: categories || [],
};

/**
 * Disponibilidad en vivo. Se carga con su propio `catch`: si el cruce falla, el catalogo sigue
 * usable con los indicadores en cero en vez de dejar la pantalla en blanco.
 */
let availability = {
  modelosPublicados: 0,
  disponiblesHoy: 0,
  porcentajeDisponible: 0,
  modelosEnArriendo: 0,
  unidadesEnArriendo: 0,
  bloqueados: 0,
};
try {
  availability = await CatalogService.getAvailabilityKpis();
} catch (error) {
  console.error("[products] Error al calcular la disponibilidad:", {
    admin: adminSession.admin.email,
    error,
  });
}

/**
 * Canon RC2.1.3 KPIs from real units (`product_unit_counts`, migration 0021). Until the view exists
 * (or if it fails) the page keeps the previous availability strip instead of showing zeros.
 */
let inventoryKpis: InventoryKpis | null = null;
try {
  const productIds = (products || []).map((product: { id: number }) => product.id);
  const chunks = await Promise.all(
    chunkProductIds(productIds).map((chunk) => ProductUnitCountsService.getByProductIds(chunk)),
  );
  const publishedModels = (products || []).filter(
    (product: { status?: string | null }) => product.status === "publish",
  ).length;
  inventoryKpis = summarizeInventoryKpis(chunks.flat(), publishedModels);
} catch (error) {
  console.error("[products] Error al calcular los KPI de unidades (0021):", {
    admin: adminSession.admin.email,
    error,
  });
}

const title = `Catálogo de Equipos | ${adminSession.admin.email}`;
---

<Base title={title}>
  <div class="container py-6">
    <!--
      D-08: el header (PageHeader + "Nuevo Equipo") vive dentro de ProductsDashboard, no aquí —
      mismo patrón que D-04/D-06, para que `actions` reciba el handler real en un único árbol React.
    -->
    <ProductsDashboard
      client:load
      initialProducts={productsData.products as any}
      initialTotal={productsData.total}
      initialCategories={categoriesData.categories as any}
      accessToken={accessToken}
    >
      {
        inventoryKpis ? (
          <InventoryKpiRow kpis={inventoryKpis} />
        ) : (
          <CatalogKpiRow kpis={availability} />
        )
      }
    </ProductsDashboard>
  </div>
</Base>
