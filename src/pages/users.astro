---
import Base from "../layout/Base.astro";
import UsersDashboardWithToaster from "../components/UsersDashboardWithToaster";
import { getServerAdmin, clearAuthCookies } from "../lib/supabase";
import { ClientStatusService } from "../services/clientStatusService";
import ClientKpiRow from "../components/ClientKpiRow.astro";

export const prerender = false;

// Verificar autenticación usando el nuevo sistema
const adminSession = await getServerAdmin(Astro);

if (!adminSession) {
  console.log('🚫 Acceso denegado a users - Usuario no es administrador');
  clearAuthCookies(Astro);
  return Astro.redirect("/");
}

console.log('✅ Admin autenticado en users:', adminSession.admin.email);

// Obtener el token de sesión de las cookies para pasarlo al componente
const sessionToken = Astro.cookies.get('sb-access-token')?.value || '';

if (!sessionToken) {
  console.warn('⚠️ No se encontró token de sesión en cookies');
}

// Los usuarios se cargan client-side desde /api/users para evitar problemas
// de serialización de props grandes con Astro Islands (client:load)
const usersData = {
  users: [],
  total: 0,
  adminInfo: {
    email: adminSession.admin.email,
    role: adminSession.admin.role,
    sessionExpiry: adminSession.expiresAt.toISOString()
  }
};

/**
 * Estado documental y financiero de la cartera. Con su propio `catch`: si falla, el listado sigue
 * usable con los indicadores en cero en vez de dejar la pantalla en blanco.
 */
let clientKpis = { total: 0, validados: 0, pendientes: 0, incompletos: 0, conDeuda: 0 };
try {
  clientKpis = await ClientStatusService.getKpis();
} catch (error) {
  console.error('[users] Error al calcular el estado de los clientes:', {
    admin: adminSession.admin.email,
    error,
  });
}

const title = `Clientes & Documentos | ${adminSession.admin.email}`;
---

<Base title={title}>
  <div class="container py-6">
    <header class="mb-5">
      <h1 class="text-xl font-semibold tracking-tight">Clientes &amp; Documentos</h1>
      <p class="mt-1 text-sm text-[var(--color-text-secondary)]">
        Gestión de clientes, verificación documental e historial operacional
      </p>
    </header>

    <ClientKpiRow kpis={clientKpis} />

    <UsersDashboardWithToaster 
      client:load
      initialUsers={usersData.users}
      initialTotal={usersData.total}
      sessionToken={sessionToken}
    />
  </div>
</Base>
