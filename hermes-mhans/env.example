# =============================================================
#  Hermes de mhans — SECRETOS
#  1. Copiá este archivo a .env        ->  cp env.example .env
#  2. Completá los valores
#  3. NUNCA lo subas a git ni lo pegues en ningún chat
#  4. chmod 600 .env
# =============================================================

# ---------- Telegram (gateway) ----------
# Token del bot NUEVO de mhans (NO reusar el del Hermes de farmiemos:
# dos gateways long-polling sobre el mismo token compiten por los updates).
# Lo genera @BotFather en Telegram con /newbot.
# Formato: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# Tu Telegram user ID NUMÉRICO (te lo dice @userinfobot).
# CRÍTICO: sin esto, el bot deniega a TODOS por seguridad (default deny).
# Es el mismo valor que ya tenés en /opt/hermes-agent/.env del VPS.
# Para varios usuarios, separá con coma: 11111111,22222222
TELEGRAM_ALLOWED_USERS=

# ---------- Proveedor de LLM ----------
# MiniMax (api.minimax.io) — mismo provider que el Hermes de farmiemos.
# Podés copiar el valor desde /opt/hermes-agent/.env del VPS (no sale del server).
MINIMAX_API_KEY=

# ---------- DB del rental — LECTURA (MCP rental + rentaldb) ----------
# Rol hermes_ro (solo SELECT sobre public) contra el Supabase self-hosted
# del rental, por red interna docker (rental-pre0225supabase-sssmcr).
# La genera/rota scripts/setup-db-role.sh EN EL VPS (no completar a mano acá).
# Formato: postgresql://hermes_ro:<password>@supabase-9cd8-db:5434/postgres
DATABASE_URL=

# ---------- DB del rental — ESCRITURA ACOTADA (solo confirm_write) ----------
# Rol hermes_rw: SELECT en public + INSERT/UPDATE SOLO en orders, order_items
# y hermes_pending_writes. SIN DELETE. La genera/rota
# scripts/setup-db-role-rw.sh EN EL VPS (no completar a mano acá).
DATABASE_URL_RW=

# ---------- DB del rental — NOTIFIER (solo lectura acotada) ----------
# Rol hermes_notifier: SELECT en orders+user_profiles, SELECT+UPDATE en
# hermes_notifications. SIN INSERT/DELETE en ninguna tabla de negocio.
# Lo genera/rota scripts/setup-db-role-notifier.sh EN EL VPS.
# Formato: postgresql://hermes_notifier:<password>@supabase-9cd8-db:5434/postgres
DATABASE_URL_NOTIFIER=

# ---------- Vocabulario de estados de órdenes (ventana T-024) ----------
# legacy (default): los siete estados que la DB acepta HOY (pre-migración 0003).
# v12: vocabulario Portal Cliente v1.2 (ocho estados) — SOLO cuando la
# migración 0003 ya esté aplicada en la DB. Cambiarlo requiere recrear el
# contenedor (docker compose up -d), no un restart.
ORDER_STATUS_VOCABULARY=legacy

# ---------- Dashboard mhans (side-effects: PDFs + emails + usuarios) ----------
# Tras crear una orden / avanzar estado / generar contrato / crear o editar
# un cliente, confirm_write dispara el endpoint del dashboard correspondiente.
# Token: secreto estático compartido con FRONTEND_API_SECRET del dashboard
# (X-API-Key header). NO es un JWT que expira.
# Si quedan vacios, las escrituras de DB funcionan pero los side-effects del
# dashboard quedan "pendientes" (degradacion honesta).
DASHBOARD_API_URL=https://dashboard.mariohans.cl
DASHBOARD_API_TOKEN=
